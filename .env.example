# COPYandPAY / OPPWA credentials are selected for the explicitly configured environment.
# Obtain the base URL, entity ID, and access token from the merchant account.
PAYMENT_GATEWAY=disabled
PAYMENT_ENVIRONMENT=test
PAYMENT_BASE_URL=https://eu-test.oppwa.com/
PAYMENT_ACCESS_TOKEN=
PAYMENT_ENTITY_ID=
PAYMENT_CURRENCY=BHD
PAYMENT_DEFAULT_TYPE=DB

# Restrict widget brands to those enabled for the configured entity.
AFS_BRANDS="VISA MASTER"
AFS_WEBHOOK_SECRET=
AFS_WIDGET_INTEGRITY=true
AFS_DESCRIPTOR="Edu World"
AFS_TEST_MODE=

# For live operation, set PAYMENT_ENVIRONMENT=live and PAYMENT_BASE_URL to the
# exact HTTPS production host supplied for the merchant account. Supply that
# environment's live credentials. Never reuse test credentials in production.
